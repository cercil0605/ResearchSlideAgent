[Unit]
Description=Update Research Slide Agent from successful GitHub CI
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
User=kei
WorkingDirectory=/home/kei/ResearchSlideAgent
Environment=GH_CONFIG_DIR=/home/kei/.config/gh
Environment=DOCKER_CONFIG=/home/kei/.docker
ExecStart=/usr/bin/python3 /home/kei/ResearchSlideAgent/scripts/deploy_poll.py
TimeoutStartSec=35min
UMask=0077
