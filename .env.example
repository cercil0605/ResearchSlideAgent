# Cloudflare Access + Managed OAuth (single-user setup; deploy/AUTH.md)
RSA_IMAGE=ghcr.io/cercil0605/researchslideagent:latest
RSA_BASE_URL=https://slides.example.org
RSA_AUTH_MODE=cloudflare
RSA_CF_TEAM_DOMAIN=https://YOUR_TEAM.cloudflareaccess.com
RSA_CF_AUDIENCE=replace-with-access-application-aud
RSA_ALLOWED_EMAILS=you@example.org
RSA_SESSION_KEY=replace-with-at-least-32-random-characters
# Optional: keep empty and upload source files through the browser initially.
RSA_ATTACHMENT_HOSTS=
RSA_DEPLOY_GITHUB_TOKEN=