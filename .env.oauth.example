# Alternative: an existing OAuth/OIDC authorization server (deploy/AUTH.md).
RSA_IMAGE=ghcr.io/cercil0605/researchslideagent:latest
RSA_BASE_URL=https://slides.example.org
RSA_AUTH_MODE=oauth
RSA_OAUTH_ISSUER=https://auth.example.org/realms/lab
RSA_JWKS_URL=https://auth.example.org/realms/lab/protocol/openid-connect/certs
RSA_OAUTH_AUDIENCE=https://slides.example.org/mcp
RSA_WEB_CLIENT_ID=research-slide-web
RSA_ALLOWED_SUBS=replace-with-broker-user-subject
RSA_SESSION_KEY=replace-with-at-least-32-random-characters
# Exact administrator-verified attachment download hosts; empty disables automatic intake.
RSA_ATTACHMENT_HOSTS=
